{
  "expo": {
    "name": "Math Game",
    "slug": "math-game",
    "version": "1.0.0",
    "owner": "xjjohnsonxs-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/67babded-0c06-4bee-aa67-412b18c4cf4b",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xjjohnson.mathgame",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./modules/math-nearby/app.plugin.js",
      "expo-updates"
    ],
    "scheme": "mathgame",
    "extra": {
      "eas": {
        "projectId": "67babded-0c06-4bee-aa67-412b18c4cf4b"
      }
    }
  }
}
